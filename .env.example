# Copy to .env for local development. In production these come from the systemd
# unit (see deploy/abacus.service), not from a file on disk.

# ---------------------------------------------------------------- required

# Where the SQLite file lives. Back this up; it is the whole ledger.
ABACUS_DB=data/abacus.db

# Exact Tailscale logins allowed to use the app, comma separated.
# A tailnet can contain shared external users and `tailscale serve` sends
# identity headers for them too, so this is an allowlist, not a formality.
ABACUS_OWNERS=you@example.com

# The public https origin, exactly as the browser sees it. WebAuthn verifies
# against this and Plaid redirects back to it, so a mismatch breaks both.
ABACUS_ORIGIN=https://abacus.your-tailnet.ts.net

# 32 random bytes, base64. Encrypts Plaid access tokens at rest.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Losing this means relinking every institution — back it up separately from
# the database, or a single stolen backup gives up both.
ABACUS_ENCRYPTION_KEY=

# ------------------------------------------------------- optional: Plaid
# Without these the app still runs; sync is off and you import files by hand.

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# ------------------------------------------------------ development only

# Pretends this login arrived from the Tailscale proxy. Ignored when
# NODE_ENV=production.
# ABACUS_DEV_USER=you@example.com

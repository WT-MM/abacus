[Unit]
Description=Abacus — personal finance ledger
Documentation=https://github.com/WT-MM/abacus
After=network-online.target tailscaled.service
Wants=network-online.target

# If the database lives on a separate mount (an array, an external disk), name
# it here. systemd will order this unit after that mount and stop it if the
# mount goes away. Without it the service can start before the disk is there,
# and would open an empty database on the mountpoint's underlying directory.
# Edit to match ABACUS_DB below; harmless to leave pointing at a normal path.
RequiresMountsFor=/var/lib/abacus

# Give up after 3 failed starts within 5 minutes rather than restarting for
# ever. The defaults do NOT achieve this: burst is 5 within 10s, but with
# RestartSec=5 only about two starts fit in a 10s window, so the counter keeps
# resetting and a broken service loops indefinitely, filling the journal.
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=simple
User=abacus
Group=abacus
WorkingDirectory=/opt/abacus

# HOST is not optional. The auth model trusts the Tailscale-User-Login header,
# which is only safe because nothing but the local `tailscale serve` proxy can
# reach this port. The app refuses to start if this is anything but loopback.
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=NODE_ENV=production
Environment=ABACUS_DB=/var/lib/abacus/abacus.db

# ORIGIN must match the public URL exactly, or SvelteKit rejects every form
# POST as cross-site and WebAuthn assertions fail against the wrong RP ID.
Environment=ORIGIN=https://abacus.your-tailnet.ts.net
Environment=ABACUS_ORIGIN=https://abacus.your-tailnet.ts.net
Environment=ABACUS_OWNERS=you@example.com

# Secrets are loaded from a root-owned file rather than being written into this
# unit, which is world-readable.
EnvironmentFile=/etc/abacus/secrets.env

ExecStart=/usr/bin/node build/index.js

Restart=on-failure
RestartSec=5

# 78 is EX_CONFIG: a bad encryption key, a non-loopback bind, a missing
# database directory. None of those become valid by trying again, so the
# service stops in a failed state where `systemctl status` shows the reason,
# instead of hiding it in a restart loop.
RestartPreventExitStatus=78

# --------------------------------------------------------------- hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/abacus
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
